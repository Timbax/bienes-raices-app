{
  "name": "bienes-raices-app",
  "version": "1.0.0",
  "description": "Mi primer proyecto de Node JS",
  "main": "index.js",
  "scripts": {
    "start": "node ./index.js",
    "server": "nodemon index.js",
    "css": " @tailwindcss/cli -i ./public/css/tailwind.css -o ./public/css/app.css --watch",
    "js": "webpack --watch",
    "dev": "concurrently  \"npm run css\" \"npm run js\"",
    "db:importar": "node ./seed/seeder.js -i",
    "db:eliminar": "node ./seed/seeder.js -e"
  },
  "keywords": [
    "MVC",
    "Pug",
    "Tailwind",
    "MySQL",
    "Sequelize"
  ],
  "author": "Daniel White",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "csurf": "^1.11.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.3",
    "pug": "^3.0.4",
    "sequelize": "^6.37.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.28",
    "postcss-cli": "^12.0.0",
    "webpack": "^5.111.0",
    "webpack-cli": "^7.2.3"
  }
}
